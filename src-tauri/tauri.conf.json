{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mutagen",
  "version": "1.1.0",
  "identifier": "com.animatheaeon.mutagen",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node js/build.js"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Mutagen",
        "width": 1360,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#0E1013",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "AnimaTheAeon",
    "copyright": "Fan-made tool. Not affiliated with Super Evil Megacorp, Paramount or Nickelodeon.",
    "shortDescription": "Save editor for TMNT: Splintered Fate",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "mainBinaryName": "Mutagen"
}